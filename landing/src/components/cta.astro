---
import Link from "./ui/link.astro";
import TilesFeatureCard from "@/components/tilesfeaturecard.astro";
---

<div class="grid sm:grid-cols-1  md:grid-cols-2 gap-4 md:px-10 md:py-20 mt-10">
  
  <div
    class="bg-green-900 p-4 max-w-5xl rounded-3xl flex flex-col items-center text-center">
    <h2 class="text-green-400 text-3xl md:text-3xl tracking-tight">
      From spreadsheets to student journeys.
    </h2>
    <p class="text-slate-400 mt-4 text-lg md:text-xl">
      Turn your student records in Notion or Excel into a simple client dashboard.
    </p>

    
  </div>

  <div class="bg-purple-900  p-4 max-w-5xl rounded-3xl flex flex-col items-center text-center">

    <h2 class="text-white text-2xl md:text-3xl tracking-tight">
      Everything your client relationship should be about.
    </h2>
    <p class="text-slate-400 mt-4 text-lg md:text-xl">
      Track sessions, payments, and progress automatically.
    </p>
    
  </div>
</div>
