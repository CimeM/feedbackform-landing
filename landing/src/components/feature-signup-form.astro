---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<section class="py-20 md:py-28 mt-20 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
      <!-- Text side -->
      <div class="flex-1 max-w-lg lg:max-w-md">
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l6 6 9-9" />
          </svg>
          Client Onboarding
        </span>

        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-gray-900 mt-6 leading-[1.1]">
          Signup forms<br/>
          <span class="text-indigo-600">from social or your website</span>
        </h2>

        <p class="text-lg text-gray-500 mt-5 leading-relaxed">
          Generate a registration links and share it with your students. 
          They fill in their details once, and they're automatically added to your dashboard.
        </p>

        <ul class="mt-8 space-y-4">
          <li class="flex items-start gap-3">
            <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full bg-indigo-600 flex items-center justify-center">
              <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l6 6 9-9" />
              </svg>
            </div>
            <span class="text-gray-600">Share the form via email, WhatsApp, or any messaging app</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full bg-indigo-600 flex items-center justify-center">
              <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l6 6 9-9" />
              </svg>
            </div>
            <span class="text-gray-600">Students auto-register with their details</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full bg-indigo-600 flex items-center justify-center">
              <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l6 6 9-9" />
              </svg>
            </div>
            <span class="text-gray-600">Follow-up from te dashboard</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="mt-0.5 shrink-0 w-5 h-5 rounded-full bg-indigo-600 flex items-center justify-center">
              <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l6 6 9-9" />
              </svg>
            </div>
            <span class="text-gray-600">Demo regisstration Form: <a href="#">Demo</a></span>
          </li>
        </ul>
      </div>

      <!-- Image side -->
      <div class="flex-1 relative">
        <!-- Device frame -->
        <div class="relative rounded-2xl md:rounded-3xl overflow-hidden border border-gray-200 shadow-xl bg-white">
          <div class="aspect-[4/3] md:aspect-[16/11] relative bg-gray-50 overflow-hidden">
            <img
              src="/students-list.png"
              alt="Student signup form interface"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Subtle decorative glow -->
        <div class="absolute -bottom-6 -right-6 w-72 h-72 bg-indigo-400/10 rounded-full blur-3xl -z-10" />
        <div class="absolute -top-6 -left-6 w-48 h-48 bg-indigo-400/10 rounded-full blur-3xl -z-10" />
      </div>
    </div>
  </div>
</section>
