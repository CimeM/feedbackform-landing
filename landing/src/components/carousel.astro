---
interface CarouselItem {
  title: string;
  emphasis: string;
  image: string;
  alt: string;
}

const items: CarouselItem[] = [
  {
    title: "Open lessons, tap add new",
    emphasis: "",
    image: "/setup_step_1.png",
    alt: "Settings screen"
  },
  {
    title: "Follow the prompts",
    emphasis: "",
    image: "/setup_step_2.png",
    alt: "Tap option"
  },
  {
    title: "Lesson is created, students notified",
    emphasis: "",
    image: "/setup_step_3.png",
    alt: "Invitation prompts"
  }
];
---

<div 
  id="tiles-carousel-scroll-gallery" 
  class="md:px-20 md:py-10 mt-20 relative overflow-hidden"
>
    <div class="p-4 pb-5">
        <h2 class="text-center text-xl sm:text-3xl font-semibold tracking-tight">
          Creating a session is easy
        </h2>
        
    </div>
    <!-- Horizontal Scroll Container -->
    <div 
        class="flex overflow-x-auto gap-6 snap-x snap-mandatory scroll-pl-20 pr-20"
        style="scroll-padding-inline: 74px; scrollbar-width: none;"
        role="list"
    >
        {items.map((item, index) => (
        <div
            class="flex-none snap-start w-[395px] min-w-[395px]"
            role="tabpanel"
            aria-labelledby={`tab-${index}`}
        >
            <div class="rounded-3xl bg-white overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <!-- Header -->
            <div class="p-6 pb-0" style="background-color:#fafafc" >
                <h3 class="text-xl text-center pt-3 font-semibold leading-tight">
                {item.title}
                
                </h3>
            </div>

            <!-- Image -->
            <div class="bg-gray-50 p-4 pb-0 pt-0">
                <img 
                src={item.image} 
                alt={item.alt}
                class="w-full h-auto object-center rounded-lg"
                loading="lazy"
                />
            </div>
            </div>
        </div>
        ))}
    </div>

    
    </div>

<script>
  const scrollContainer = document.getElementById('tiles-carousel-scroll-gallery');
  const dots = document.querySelectorAll('.dotnav-item') || scrollContainer.querySelectorAll('.absolute \\> div > a');
  const cards = scrollContainer.querySelectorAll('[role="tabpanel"]');
  
  let currentIndex = 0;

  function updateActiveDot(index: number) {
    const allDots = scrollContainer.querySelectorAll('a[role="tab"]');
    allDots.forEach((dot: Element, i: number) => {
      if (i === index) {
        dot.classList.add('bg-blue-600', 'scale-125');
        dot.classList.remove('bg-gray-300');
        dot.setAttribute('aria-selected', 'true');
        dot.setAttribute('tabindex', '0');
      } else {
        dot.classList.remove('bg-blue-600', 'scale-125');
        dot.classList.add('bg-gray-300');
        dot.setAttribute('aria-selected', 'false');
        dot.setAttribute('tabindex', '-1');
      }
    });
    currentIndex = index;
  }

  scrollContainer.addEventListener('scroll', () => {
    const scrollPos = scrollContainer.scrollLeft;
    const cardWidth = 395;
    const newIndex = Math.round(scrollPos / cardWidth);
    
    if (newIndex !== currentIndex && newIndex < cards.length) {
      updateActiveDot(newIndex);
    }
  });

  const allDots = scrollContainer.querySelectorAll('a[role="tab"]');
  allDots.forEach((dot: Element, index: number) => {
    dot.addEventListener('click', (e: Event) => {
      e.preventDefault();
      scrollContainer.scrollTo({
        left: index * 395,
        behavior: 'smooth'
      });
      updateActiveDot(index);
    });
  });

  
</script>