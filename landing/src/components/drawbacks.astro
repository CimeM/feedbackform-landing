---
import Container from "@/components/container.astro";
import { Icon } from "astro-icon/components";
---

<section class="mt-24 py-20 bg-white-50 border-t border-slate-100">
  <Container>

    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-16">
      <div class="flex justify-center text-center gap-4">
        <div class="mb-3 rounded-xl bg-green-50 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
          </svg>
        </div>
        <p class="text-sm font-semibold uppercase tracking-widest text-indigo-500 mb-3">
          Stuff That Shouldn’t Happen in 2026
        </p>
      </div>
      <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight text-slate-800 leading-tight">
        Tired of endless organising?
      </h2>
      <h1 class="mt-4 text-lg text-slate-500">
        Here is what is really holding you back.
      </h1>
    </div>

    <ul class="flex flex-wrap justify-center gap-5 px-2 text-slate-500 list-none">

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        Outdated spreadsheets
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        Bloated CRMs
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        Complicated CRMs
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        Paying for features you dont use
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        No mobile access?
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        Time waisted on comunication
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        No feedback
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        Advertisement?
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        Time wasted organizing
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        No record of attendence
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray mt-1" name="bx:bxs-time" />
        No payment records
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray" name="bx:bxs-time" />
        Feeling burned out
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray" name="bx:bxs-time" />
        Hours lost on setup not teaching
      </li>

      <li class="flex gap-3 bg-slate-100 p-2 m-5 rounded-2xl">
        <Icon class="text-gray" name="bx:bxs-time" />
        Stuck using spreadsheets?
      </li>
    </ul>
    


    <!-- Bottom callout strip -->
    <div class="mt-14 max-w-3xl mx-auto bg-indigo-600 rounded-2xl px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class="text-white font-semibold text-lg leading-snug">
          There is a simpler way to stay organised.
        </p>
        <p class="text-indigo-200 text-sm mt-1">
          Built for teachers. Ready in minutes. No tech team required.
        </p>
      </div>
      <a
        href="https://crm.rivieraaapps.com"
        target="_blank"
        rel="noopener"
        class="flex-shrink-0 inline-flex items-center gap-2 bg-white text-indigo-600 font-semibold text-sm px-6 py-3 rounded-xl hover:bg-indigo-50 transition-colors duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Start for Free
      </a>
    </div>

  </Container>
</section>
