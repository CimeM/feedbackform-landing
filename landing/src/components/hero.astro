---
import { Picture } from "astro:assets";
import heroImage from "@/assets/client_list.png";
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid lg:grid-cols-2 place-items-center pt-16 pb-8 md:pt-12 md:pb-24">
  <div class="py-6  md:order-1 hidden md:block">
    <Picture
      src={heroImage}
      alt="List of clients"
      widths={[300, 600, 800, 1000, 1200, 1600]}
      sizes="(max-width: 768px) 80vw, (max-width: 1200px) 50vw, 600px"
      loading="eager"
      format="avif"
      class="rounded-3xl"
    />
  </div>
  <div>
    <h1 class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter
           bg-[linear-gradient(45deg,#6366f1,#38bdf8,#a855f7)]
           bg-clip-text text-transparent inline-block">
      Client Dashboard for Teachers
    </h1>

    <p class="text-lg mt-4 text-slate-600 max-w-xl">
      A simple dashboard where teachers manage students, schedule sessions and track budget.
      Track enrolments, instalments, and reminders in one place.
    </p>

    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        href="#"
        href="https://lerins.rivieraapps.com"
        target="_blank"
        class="flex gap-1 items-center justify-center bg-gray-300 rounded-xl"
        rel="noopener">
        
        Open app
      </Link>
    </div>
  </div>
</main>
