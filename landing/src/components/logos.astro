---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24 bg-slate-50 py-10 rounded-3xl">
  <h2 class="text-center ">Helping teachers since 2019</h2>
  <p class="text-center text-slate-500">Many professionals use the app to organise their students and clients.</p>
  <div class="flex gap-8 md:gap-20 items-center justify-center mt-10 flex-wrap">

    <div class=" size-9 md:size-12 p-1 rounded-2xl bg-red-100">
      <img
        class="rounded-full"
        src="https://api.dicebear.com/10.x/micah/svg?seed=Katarina"
        alt="avatar"
      />
      <label class="text-sm">Katarina</label>
    </div>

    <div class="size-9 md:size-12 p-1 rounded-2xl bg-green-100">
      <img
        class="rounded-full"
        src="https://api.dicebear.com/10.x/micah/svg?seed=Felix"
        alt="avatar"
      />
      <label class="text-sm">Felix</label>
    </div>

    <div class="size-9 md:size-12 p-1 rounded-2xl bg-red-100">
      <img
        rounded="rounded-full"
        src="https://api.dicebear.com/10.x/micah/svg?seed=Luca"
        alt="avatar"
      />
      <label class="text-sm">Luca</label>
    </div>

    <div class="size-9 md:size-12 p-1 rounded-2xl bg-gray-100">
      <img
        class="rounded-full"
        src="https://api.dicebear.com/10.x/micah/svg?seed=Antonio"
        alt="avatar"
      />
      <label class="text-sm">Antonio</label>
    </div>

    <div class="size-9 md:size-12 p-1 rounded-2xl bg-blue-100">
      <img
        class="rounded-full"
        src="https://api.dicebear.com/10.x/micah/svg?seed=Giulia"
        alt="avatar"
      />
      <label class="text-sm">Giulia</label>
    </div>


  </div>
</div>
