---
import Layout from "@/layouts/Layout.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Container from "@/components/container.astro";

const faqs = [
  {
    category: "Getting Started",
    questions: [
      {
        question: "What is Lérins AI?",
        answer:
          "Lérins AI is a client dashboard designed for teachers, tutors, and coaches. It helps you keep track of your students, their sessions, payments, and progress — all in one place. You can use it on your phone or computer. It replaces spreadsheets, Google Forms, and separate scheduling tools.",
      },
      {
        question: "How do I collect student information from social media?",
        answer:
          "You can create an onboarding form inside Lérins AI. When someone fills it out, their contact information appears automatically in your Students list. Share the link on Instagram, Facebook, TikTok, or anywhere your students are. It works like Google Forms, but everything stays inside your Lérins AI dashboard. No manual data entry needed.",
      },
      {
        question: "Can I see where each student is in the onboarding process?",
        answer:
          "Yes. Each student has a status that you can update as they move through your process — new lead, contacted, ready to enroll, or active. You can also add notes after every call or conversation. This way you always know who needs attention next.",
      },
      {
        question: "Is Lérins AI free to use?",
        answer:
          "Yes, Lérins AI has a free starter version. Premium plans add more features if you need them.",
      },
    ],
  },
  {
    category: "Features",
    questions: [
      {
        question: "How do onboarding forms work?",
        answer:
          "You build a simple form inside Lérins AI with the fields you need — name, phone number, email. Lérins AI gives you a link. Share it on social media or in messages. When someone submits the form, they appear as a new student in your dashboard. It is the easiest way to turn social media followers into students.",
      },
      {
        question: "Can I send emails to potential students?",
        answer:
          "Yes. Lérins AI includes email templates you can send with one click. Use them to welcome new leads, follow up after a call, or remind someone to book their first session. You can also use AI to help write and personalize each message. It takes seconds.",
      },
      {
        question: "Can parents see their child's progress?",
        answer:
          "Yes. Lérins AI has a parent view that lets parents see session feedback, upcoming classes, and what they owe. This keeps everyone on the same page and reduces back-and-forth messages.",
      },
      {
        question: "Does Lérins AI work on a phone?",
        answer:
          "Yes. Lérins AI works on mobile and desktop. You can check your schedule, update a student status, or send an email from anywhere.",
      },
      {
        question: "Does Lérins AI support dark mode?",
        answer:
          "Yes. Lérins AI respects your system preference and you can also switch between light and dark mode manually.",
      },
    ],
  },
  {
    category: "Billing & Pricing",
    questions: [
      {
        question: "How do I add payments from my students?",
        answer:
          "You add payments manually inside Lérins AI. This keeps things simple. If you would like an automatic payment integration, let us know.",
      },
      {
        question: "How do I pay for my subscription?",
        answer:
          "Subscriptions are paid through PayPal. Annual payments are the only option right now. Send us your payment confirmation and we will activate your plan.",
      },
      {
        question: "Can I cancel my subscription at any time?",
        answer:
          "Yes. You can cancel from your account dashboard at any time. Your access stays active until the end of your current billing period.",
      },
      {
        question: "Do you offer refunds?",
        answer:
          "We do not offer refunds at this time.",
      },
    ],
  },
  {
    category: "Support",
    questions: [
      {
        question: "How do I get help if something is not working?",
        answer:
          "Email us at langrivieraapps@gmail.com or use the contact form on our website. We usually respond within 24 hours.",
      },
      {
        question: "Is Lérins AI only for teachers?",
        answer:
          "Lérins AI is built for teachers and tutors, but it works for any small business that manages students or clients. If you run coaching, mentoring, or training programs, Lérins AI can help you stay organized.",
      },
    ],
  },
];
---

<Layout title="FAQ">
  <Container>
    <Sectionhead>
      <Fragment slot="title">FAQ</Fragment>
      <Fragment slot="desc">Frequently asked questions.</Fragment>
    </Sectionhead>

    <div class="mx-auto max-w-3xl mt-14">
      <!-- Intro -->
      <p class="text-lg text-slate-600 text-center mb-12">
        Here are answers to the most common questions about Lérins AI. If you
        cannot find what you are looking for,
        <a href="/contact" class="text-indigo-600 hover:underline font-medium">
          reach out to us
        </a>.
      </p>

      <!-- FAQ Categories -->
      <div class="space-y-12">
        {
          faqs.map((group) => (
            <div>
              <!-- Category Heading -->
              <h2 class="text-xl font-semibold text-slate-800 mb-6 pb-2 border-b border-slate-200">
                {group.category}
              </h2>

              <!-- Questions -->
              <div class="space-y-4">
                {group.questions.map((item) => (
                  <details class="group bg-slate-50 border border-slate-200 rounded-xl px-6 py-4 cursor-pointer">
                    <summary class="flex justify-between items-center text-slate-800 font-medium text-base list-none select-none">
                      {item.question}
                      <span class="ml-4 flex-shrink-0 text-slate-400 transition-transform duration-300 group-open:rotate-45">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="20"
                          height="20"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round">
                          <line x1="12" y1="5" x2="12" y2="19" />
                          <line x1="5" y1="12" x2="19" y2="12" />
                        </svg>
                      </span>
                    </summary>
                    <p class="mt-3 text-slate-600 text-sm leading-relaxed">
                      {item.answer}
                    </p>
                  </details>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <!-- Bottom CTA -->
      <div
        class="mt-16 text-center bg-indigo-50 border border-indigo-100 rounded-2xl px-8 py-10">
        <h3 class="text-xl font-semibold text-slate-800 mb-2">
          Still have questions?
        </h3>
        <p class="text-slate-500 mb-6">
          Our team is happy to help you with anything you need.
        </p>
        <a
          href="/contact"
          class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-3 rounded-lg transition-colors duration-200">
          Get in Touch
        </a>
      </div>
    </div>
  </Container>
</Layout>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary {
    color: #4f46e5;
  }
</style>
