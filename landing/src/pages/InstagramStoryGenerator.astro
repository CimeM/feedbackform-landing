---
import LayoutFS from "@/layouts/LayoutFS.astro";
---


<LayoutFS>
  <div class="w-full h-screen h-[100dvh] bg-[#0d1117] text-[#adbac7] flex flex-col justify-center items-center p-2 sm:p-3 md:p-4 overflow-hidden font-sans">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-4 w-full max-w-7xl h-full items-center justify-center">
      
      <div 
        id="dataInputView" 
        class="flex md:col-span-5 lg:col-span-5 bg-[#161b22] border border-[#30363d] p-4 rounded-2xl shadow-2xl flex-col gap-3 h-full max-h-[92vh] overflow-hidden"
      >
        
        <div class=" flex justify-between items-center pb-2 border-b border-[#30363d]">
          <div>
            <h2 class="text-sm font-bold text-white flex items-center gap-2">
              Lérins AI
            </h2>
            <h2 class="hidden text-sm font-bold text-white flex items-center gap-2">
              <span>NANO_LOCAL_v1.3</span>
              <span id="nanoStatusBadge" class="text-[10px] font-mono px-2 py-0.5 rounded border border-[#30363d] bg-[#1c2128] text-slate-400">Checking...</span>
            </h2>
          </div>

          <div class="flex items-center gap-2">
            <button id="setupBtn" class="hidden text-xs bg-[#21262d] hover:bg-[#30363d] text-[#adbac7] px-2.5 py-1 rounded-md border border-[#30363d] transition-colors">
              ⚙ Setup
            </button>
            <button id="toggleModeBtn" class="md:hidden text-slate-400 hover:text-white text-xs px-2 py-1 rounded-lg bg-slate-800 ">
              <span id="toggleModeText">JSON View</span>
            </button>
            <button id="closeJsonBtn" class="md:hidden bg-[#539bf5]/20 hover:bg-[#539bf5]/30 text-[#539bf5] font-semibold text-xs px-2.5 py-1 rounded-md border border-[#539bf5]/40 transition-colors">
              Slides &rarr;
            </button>
          </div>
        </div>

        <div id="aiPromptContainer" class="flex flex-col flex-1 overflow-hidden gap-2">
          
          <div class="hidden flex flex-col gap-1">
            <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400">AI Model Provider:</label>
            <select id="engineSelect" class="bg-[#0d1117] text-[#adbac7] text-xs border border-[#30363d] rounded-lg p-2 focus:outline-none focus:border-[#539bf5]">
              <option value="nano" id="optNano" disabled>Gemini Nano (Local - Checking...)</option>
              <option value="hardcoded">Hardcoded Key (Gemini Cloud API)</option>
              <option value="custom">Custom Gemini API Key</option>
            </select>
            
            <input type="password" id="customApiKeyInput" placeholder="Paste Gemini API Key (AIZA...)" class="hidden bg-[#0d1117] border border-[#30363d] text-xs text-white p-2 rounded-lg outline-none focus:border-[#539bf5] mt-1" />
          </div>

          <div id="chatFlow" class="flex-1 bg-[#0d1117] border border-[#30363d] rounded-xl p-3 overflow-y-auto flex flex-col gap-3 font-sans text-xs">
            <div class="msg nano bg-[#161b22] border border-[#30363d] p-3 rounded-xl text-[#adbac7] max-w-[85%] self-start">
              👋 Local model ready. Ask me to generate Quizzes or Daily Phrases!
            </div>
          </div>

          <div class="flex gap-2 pt-1">
            <input type="text" id="promptInput" placeholder="Message model..." autocomplete="off" class="flex-1 bg-[#0d1117] border border-[#30363d] text-white text-xs p-2.5 rounded-xl outline-none focus:border-[#539bf5]" />
            <button id="stopBtn" class="hidden bg-[#e5534b] text-white font-bold text-xs px-3 py-2.5 rounded-xl transition-colors">STOP</button>
            <button id="sendBtn" class="bg-[#539bf5] hover:bg-[#4182d6] text-white font-bold text-xs px-4 py-2.5 rounded-xl transition-colors">SEND</button>
          </div>
        </div>

        <div id="jsonCodeContainer" class="hidden flex-col gap-3 flex-1">
          <textarea 
            id="jsonConfigInput" 
            spellcheck="false"
            class="w-full flex-1 min-h-[200px] bg-[#0d1117] border border-[#30363d] rounded-xl text-[#539bf5] font-mono text-xs p-3 focus:outline-none focus:border-[#539bf5] resize-none"
          ></textarea>

          <div class="flex gap-2">
            <button id="loadSampleBtn" class="flex-1 bg-[#21262d] hover:bg-[#30363d] text-white font-medium text-xs py-2 px-3 rounded-xl transition-colors">
              Reset Sample
            </button>
            <button id="generateBtn" class="hidden flex-1 bg-[#539bf5] hover:bg-[#4182d6] text-white font-bold text-xs py-2 px-3 rounded-xl transition-colors">
              Apply Canvas &rarr;
            </button>
          </div>
        </div>

      </div>

      <div 
        id="storyEditorView" 
        class="hidden md:flex col-span-1 md:col-span-7 lg:col-span-7 justify-center items-center h-full w-full"
      >
        <div class="relative w-full max-w-[420px] md:max-w-[460px] h-full max-h-[88vh] md:max-h-[92vh] bg-black rounded-3xl overflow-hidden shadow-2xl border border-[#30363d] flex flex-col items-center justify-center">
          
          <div id='topNavOnCanvas' class="absolute top-0 inset-x-0 z-20 flex justify-between items-center p-3 bg-gradient-to-b from-black/80 via-black/30 to-transparent">
            <button id="openJsonBtn" class="md:hidden bg-white/20 hover:bg-white/30 text-white text-xs px-3 py-1.5 rounded-full backdrop-blur-md transition-colors">
              &larr; AI
            </button>

            <div class="flex items-center gap-1 text-white text-xs font-semibold bg-black/40 px-2.5 py-1 rounded-full backdrop-blur-md border border-white/10">
              <button id="prevBtn" class="bg-white/20 hover:bg-white/30 text-white w-5 h-5 rounded-full flex items-center justify-center transition-colors">&lsaquo;</button>
              <span id="slideIndicator" class="px-1 text-[11px]">1/1</span>
              <button id="nextBtn" class="bg-white/20 hover:bg-white/30 text-white w-5 h-5 rounded-full flex items-center justify-center transition-colors">&rsaquo;</button>
            </div>

            <button id="downloadBtn" class="bg-[#539bf5] hover:bg-[#4182d6] text-white font-bold text-xs px-3 py-1.5 rounded-xl transition-colors">
              Download
            </button>
          </div>

          <div id="sideToolBox" class=" absolute right-2 top-16 z-20 flex flex-col items-end gap-2 bg-black/50 p-2 rounded-2xl backdrop-blur-md border border-white/10" style="max-width:15vw;" >
            <div class="flex flex-col items-center gap-1 w-full" >
              <label for="bgTypeSelect" class="text-[9px] font-bold text-slate-300 uppercase tracking-wider" >BG</label>
              <select id="bgTypeSelect" class="bg-black/80 text-white text-[11px] rounded-lg px-1.5 py-1 border border-white/20 focus:outline-none max-w-[80px]" style="width: -webkit-fill-available;">
                <optgroup label="Gradients">
                  <option value="linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)">Instagram</option>
                  <option value="linear-gradient(135deg, #e4e7eb, #eaedf1)">Slate Light</option>
                  <option value="linear-gradient(135deg, #0f172a, #334155)">Slate Dark</option>
                  <option value="linear-gradient(135deg, #4c1d95, #c084fc)">Purple Dusk</option>
                  <option value="linear-gradient(135deg, #065f46, #34d399)">Emerald</option>
                  <option value="linear-gradient(135deg, #1e3a8a, #38bdf8)">Ocean Blue</option>
                </optgroup>
                <optgroup label="Solid Colors">
                  <option value="#0f172a">Dark Navy</option>
                  <option value="#000000">Pure Black</option>
                  <option value="#4c1d95">Deep Purple</option>
                  <option value="custom">Custom...</option>
                </optgroup>
              </select>
              <input type="color" id="bgColorPicker" value="#1e293b" class="w-6 h-6 rounded-full bg-transparent border-0 cursor-pointer hidden mt-1" />
            </div>

            <div class="w-full h-px bg-white/10 my-0.5"></div>

            <div class="flex flex-col items-center gap-1  w-full">
              <label for="textColorPicker" class="text-[9px] font-bold text-slate-300 uppercase tracking-wider">Text</label>
              <input type="color" id="textColorPicker" value="#1b1818" class="w-6 h-6 rounded-full bg-transparent border-0 cursor-pointer" />
            </div>

            <div class="w-full h-px bg-white/10 my-0.5"></div>

            <div class="flex flex-col items-center gap-1 w-full">
              <label for="fontSelect" class="text-[9px] font-bold text-slate-300 uppercase tracking-wider">Font</label>
              <select id="fontSelect" class="bg-black/80 text-white text-[11px] rounded-lg px-1.5 py-1 border border-white/20 focus:outline-none max-w-[80px]" style="width: -webkit-fill-available;">
                <optgroup label="Instagram Styles">
                  <option value="system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif">Instagram Classic</option>
                  <option value="'Montserrat', 'Trebuchet MS', 'Arial Black', sans-serif">Instagram Modern</option>
                  <option value="'Caveat', 'Brush Script MT', cursive">Instagram Neon</option>
                  <option value="'Space Mono', 'Courier New', monospace">Instagram Typewriter</option>
                  <option value="'Anton', 'Impact', 'Arial Black', sans-serif">Instagram Strong</option>
                  <option value="'Playfair Display', 'Georgia', serif">Instagram Literature</option>
                </optgroup>

                <optgroup label="Sans-Serif">
                  <option value="system-ui, -apple-system, sans-serif">Sans</option>
                  <option value="'Helvetica Neue', Helvetica, Arial, sans-serif">Helvetica</option>
                  <option value="'Inter', sans-serif">Inter</option>
                </optgroup>

                <optgroup label="Serif">
                  <option value="'Georgia', serif">Georgia</option>
                  <option value="'Times New Roman', Times, serif">Times</option>
                  <option value="'Merriweather', serif">Merriweather</option>
                </optgroup>

                <optgroup label="Display & Monospace">
                  <option value="'Impact', sans-serif">Impact</option>
                  <option value="'Courier New', monospace">Courier</option>
                  <option value="'Oswald', sans-serif">Oswald</option>
                </optgroup>

              </select>
            </div>

            <div class="flex flex-col items-center gap-1 w-full">
              <label for="textStyleSelect" class="text-[9px] font-bold text-slate-300 uppercase tracking-wider">Style</label>
              <select id="textStyleSelect" class="bg-black/80 text-white text-[11px] rounded-lg px-1.5 py-1 border border-white/20 focus:outline-none max-w-[80px]" style="width: -webkit-fill-available;">
                <option value="bold">Bold</option>
                <option value="normal">Normal</option>
                <option value="italic">Italic</option>
                <option value="bold italic">Bold Italic</option>
              </select>
            </div>

            <div class="w-full h-px bg-white/10 my-0.5"></div>

            <div class="flex flex-col items-center gap-1 w-full">
              <label for="fontSizeSelect" class="text-[9px] font-bold text-slate-300 uppercase tracking-wider">Font Size</label>
              <div class="justify-items-center gap-1 w-full">
                <!-- Increase Button -->
                <button
                  type="button"
                  id="increaseFontSizeBtn"
                  class="flex items-center justify-center min-w-[44px] h-[44px] bg-black/80 hover:bg-white/10 active:scale-95 text-white font-bold rounded-lg border border-white/20 transition-all select-none"
                  aria-label="Increase font size"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                  </svg>
                </button>

                <!-- Decrease Button -->
                <button
                  type="button"
                  id="decreaseFontSizeBtn"
                  class="flex items-center justify-center min-w-[44px] h-[44px] bg-black/80 hover:bg-white/10 active:scale-95 text-white font-bold rounded-lg border border-white/20 transition-all select-none"
                  aria-label="Decrease font size"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 13H5v-2h14v2z"/>
                  </svg>
                </button>

                
              </div>
            </div>

            <button
              id="toggleUiBtn"
              title="Toggle Instagram UI Overlays"
              class="w-full p-2.5 rounded-xl bg-[#21262d] text-gray-300 hover:text-white hover:bg-[#30363d] transition-all duration-200 border border-[#30363d] flex items-center justify-center gap-2"
            >
              <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>

          </div>

          <canvas id="storyCanvas" width="1080" height="1920" class="w-full h-full object-contain"></canvas>

        </div>
      </div>

    </div>
  </div>

  <div id="modal-overlay" class="hidden fixed inset-0 bg-black/80 z-50 items-center justify-center p-4">
    <div class="bg-[#161b22] border border-[#30363d] rounded-2xl max-w-md w-full p-5 flex flex-col gap-3 text-[#adbac7]">
      <div class="flex justify-between items-center">
        <h3 class="text-white font-bold text-base">Required Chrome Flags</h3>
        <button id="closeModal" class="text-slate-400 hover:text-white text-xl font-bold">&times;</button>
      </div>
      <p class="text-xs">Enable these flags in <code class="bg-[#0d1117] px-1 py-0.5 rounded border border-[#30363d] text-[#539bf5]">chrome://flags</code> for built-in Nano AI:</p>

      <div class="bg-[#0d1117] border border-[#30363d] p-2.5 rounded-xl text-xs flex flex-col gap-1">
        <div class="flex justify-between items-center">
          <strong class="text-white">1. Prompt API</strong>
          <button class="bg-[#30363d] hover:bg-slate-700 text-white text-[10px] px-2 py-0.5 rounded" onclick="navigator.clipboard.writeText('chrome://flags/#prompt-api-for-gemini-nano'); alert('Flag URL Copied!');">Copy</button>
        </div>
        <code class="text-[11px] text-slate-400">#prompt-api-for-gemini-nano</code>
      </div>

      <div class="bg-[#0d1117] border border-[#30363d] p-2.5 rounded-xl text-xs flex flex-col gap-1">
        <div class="flex justify-between items-center">
          <strong class="text-white">2. Optimization Guide</strong>
          <button class="bg-[#30363d] hover:bg-slate-700 text-white text-[10px] px-2 py-0.5 rounded" onclick="navigator.clipboard.writeText('chrome://flags/#optimization-guide-on-device-model'); alert('Flag URL Copied!');">Copy</button>
        </div>
        <code class="text-[11px] text-slate-400">#optimization-guide-on-device-model</code>
      </div>

      <div class="bg-[#0d1117] border border-[#30363d] p-2.5 rounded-xl text-xs flex flex-col gap-1">
        <div class="flex justify-between items-center">
          <strong class="text-white">3. Text Safety</strong>
          <button class="bg-[#30363d] hover:bg-slate-700 text-white text-[10px] px-2 py-0.5 rounded" onclick="navigator.clipboard.writeText('chrome://flags/#text-safety-classifier'); alert('Flag URL Copied!');">Copy</button>
        </div>
        <code class="text-[11px] text-slate-400">#text-safety-classifier</code>
      </div>

      <p class="text-[11px] text-[#c69026] font-medium">* Relaunch Chrome after enabling all three.</p>
    </div>
  </div>
</LayoutFS>

<style>
  .streaming::after {
    content: '▋';
    animation: blink 0.8s infinite;
    color: #539bf5;
  }
  @keyframes blink { 50% { opacity: 0; } }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat:wght@600&family=Montserrat:wght@700;800&family=Playfair+Display:ital,wght@0,600;1,600&family=Space+Mono:wght@700&display=swap" rel="stylesheet">


<script>

  import { drawText, clearMeasurementCache } from 'canvas-txt';

  // Flush font measurement cache once fonts are loaded
  if (typeof document !== 'undefined' && document.fonts) {
    document.fonts.ready.then(() => clearMeasurementCache());
  }

  interface SlideData {
    id: string;
    type?: "quiz" | "phrases";
    title?: string;
    items?: string[];
    backgroundColor: string;
    textColor: string;
    fontFamily: string;
    question?: string;
    options?: string[];
    watermarkText: string;
    textStyle?: "bold" | "normal" | "italic" | "bold italic";
    fontSize?: 45;
  }

  interface StoryConfig {
    slides: SlideData[];
  }

  const HARDCODED_DEMO_KEY = "AQ.Ab8RN6IegyRq8ird_QQTNY6X_nocihg-OHyDvH8CZhNtbbmN";

  const defaultSample: StoryConfig = {
    slides: [
      {
        id: "slide-1",
        type: "phrases",
        title: "🇫🇷 Daily Phrases",
        items: [
          "Bonjour (Good morning/hello)",
          "Bonsoir (Good evening)",
          "Merci beaucoup (Thank you very much)",
          "S'il vous plaît (Please)",
          "Au revoir (Goodbye)",
          "À bientôt (See you soon)"
        ],
        backgroundColor: "linear-gradient(135deg, #e4e7eb, #eaedf1)",
        textColor: "#1b1818",
        fontFamily: "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        fontWeight: "bold",
        fontSize: 45,
        watermarkText: "Lérins AI"
      },
      {
        id: "slide-2",
        type: "quiz",
        backgroundColor: "linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)",
        textColor: "#1b1818",
        fontFamily: "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        question: "Which feature should we build next?",
        options: ["AI Generator", "Custom Fonts", "More Layouts"],
        watermarkText: "Lérins AI",
        fontWeight: "bold",
        fontSize: 45
      }
    ]
  };

  const OPTION_PREFIXES = ["A", "B", "C", "D", "E", "F"];

  let config: StoryConfig = defaultSample;
  let currentSlideIndex = 0;
  let isAiMode = true;
  let nanoSession: any = null;
  let abortController: AbortController | null = null;

  // DOM Elements
  const dataInputView = document.getElementById("dataInputView")!;
  const openJsonBtn = document.getElementById("openJsonBtn")!;
  const closeJsonBtn = document.getElementById("closeJsonBtn")!;
  const toggleModeBtn = document.getElementById("toggleModeBtn")!;
  const toggleModeText = document.getElementById("toggleModeText")!;

  const aiPromptContainer = document.getElementById("aiPromptContainer")!;
  const jsonCodeContainer = document.getElementById("jsonCodeContainer")!;
  const engineSelect = document.getElementById("engineSelect") as HTMLSelectElement;
  const optNano = document.getElementById("optNano") as HTMLOptionElement;
  const customApiKeyInput = document.getElementById("customApiKeyInput") as HTMLInputElement;
  const nanoStatusBadge = document.getElementById("nanoStatusBadge")!;

  const chatFlow = document.getElementById("chatFlow")!;
  const promptInput = document.getElementById("promptInput") as HTMLInputElement;
  const sendBtn = document.getElementById("sendBtn") as HTMLButtonElement;
  const stopBtn = document.getElementById("stopBtn") as HTMLButtonElement;

  const modalOverlay = document.getElementById("modal-overlay")!;
  const setupBtn = document.getElementById("setupBtn")!;
  const closeModal = document.getElementById("closeModal")!;

  const jsonConfigInput = document.getElementById("jsonConfigInput") as HTMLTextAreaElement;
  const generateBtn = document.getElementById("generateBtn")!;
  const loadSampleBtn = document.getElementById("loadSampleBtn")!;

  const canvas = document.getElementById("storyCanvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const bgTypeSelect = document.getElementById("bgTypeSelect") as HTMLSelectElement;
  const bgColorPicker = document.getElementById("bgColorPicker") as HTMLInputElement;
  const textColorPicker = document.getElementById("textColorPicker") as HTMLInputElement;
  const fontSelect = document.getElementById("fontSelect") as HTMLSelectElement;
  const prevBtn = document.getElementById("prevBtn") as HTMLButtonElement;
  const nextBtn = document.getElementById("nextBtn") as HTMLButtonElement;
  const downloadBtn = document.getElementById("downloadBtn") as HTMLButtonElement;
  const slideIndicator = document.getElementById("slideIndicator") as HTMLSpanElement;
  const textStyleSelect = document.getElementById("textStyleSelect") as HTMLSelectElement;
  const toggleUiBtn = document.getElementById("toggleUiBtn");  
  jsonConfigInput.value = JSON.stringify(defaultSample, null, 2);
  
  // Detect Local Gemini Engine
  async function checkNanoAvailability() {
    try {
      const engine = (window as any).ai?.languageModel || (window as any).LanguageModel;
      if (engine) {
        optNano.disabled = false;
        optNano.textContent = "Gemini Nano (Local On-Device)";
        engineSelect.value = "nano";
        nanoStatusBadge.textContent = "Nano Ready";
        nanoStatusBadge.className = "text-[10px] font-mono px-2 py-0.5 rounded border border-[#57ab5a]/40 bg-[#57ab5a]/10 text-[#57ab5a]";
        return;
      }
    } catch (e) {}

    optNano.disabled = true;
    optNano.textContent = "Gemini Nano (Unavailable)";
    engineSelect.value = "hardcoded";
    nanoStatusBadge.textContent = "Nano Offline";
    nanoStatusBadge.className = "text-[10px] font-mono px-2 py-0.5 rounded border border-[#e5534b]/40 bg-[#e5534b]/10 text-[#e5534b]";
  }

  engineSelect.addEventListener("change", () => {
    if (engineSelect.value === "custom") {
      customApiKeyInput.classList.remove("hidden");
    } else {
      customApiKeyInput.classList.add("hidden");
    }
  });

  setupBtn.onclick = () => modalOverlay.classList.remove("hidden");
  closeModal.onclick = () => modalOverlay.classList.add("hidden");

  toggleModeBtn.addEventListener("click", () => {
    isAiMode = !isAiMode;
    if (isAiMode) {
      aiPromptContainer.classList.remove("hidden");
      aiPromptContainer.classList.add("flex");
      jsonCodeContainer.classList.add("hidden");
      jsonCodeContainer.classList.remove("flex");
      toggleModeText.textContent = "JSON \u2192";
    } else {
      aiPromptContainer.classList.add("hidden");
      aiPromptContainer.classList.remove("flex");
      jsonCodeContainer.classList.remove("hidden");
      jsonCodeContainer.classList.add("flex");
      toggleModeText.textContent = "\u2728 Chat View \u2192";
    }
  });

  toggleUiBtn?.addEventListener("click", () => {


    // 1. Hide overlays
    document.getElementById('sideToolBox')?.classList.add("hidden");
    document.getElementById('topNavOnCanvas')?.classList.add("hidden");

    // 2. Set timer to automatically restore overlays after 2 seconds (2000 ms)
    overlayTimeout = setTimeout(() => {
      document.getElementById('sideToolBox')?.classList.remove("hidden");
      document.getElementById('topNavOnCanvas')?.classList.remove("hidden");
    }, 2000);
  });

  function addBubble(text: string, type: 'user' | 'nano') {
    const div = document.createElement("div");
    if (type === 'user') {
      div.className = "msg user bg-[#539bf5] text-white p-2.5 rounded-xl max-w-[85%] self-end font-medium";
    } else {
      div.className = "msg nano streaming bg-[#161b22] border border-[#30363d] text-[#adbac7] p-2.5 rounded-xl max-w-[85%] self-start whitespace-pre-wrap flex flex-col gap-1";
    }
    
    // Use innerHTML so HTML elements render correctly
    div.innerHTML = text; 
    
    chatFlow.appendChild(div);
    chatFlow.scrollTop = chatFlow.scrollHeight;
    return div;
  }

  function setStreamingUI(isStreaming: boolean) {
    sendBtn.style.display = isStreaming ? "none" : "block";
    stopBtn.style.display = isStreaming ? "block" : "none";
    promptInput.disabled = isStreaming;
    if (!isStreaming) promptInput.focus();
  }

  stopBtn.onclick = () => {
    if (abortController) abortController.abort();
  };

  async function handleChatSend() {
    const query = promptInput.value.trim();
    if (!query) return;

    addBubble(query, 'user');
    promptInput.value = "";
    const aiBubble = addBubble(
      `<span>Generating slides... <span class="inline-block animate-spin">⚆</span></span>`, 
      'nano'
    );
    setStreamingUI(true);

    abortController = new AbortController();

    const systemPrompt = `You are a JSON generator for Instagram Stories slides. 
      Generate either "quiz" or "phrases" type slides.
      Max 10 items for "phrases". 
      For "phrases" slides, keep items 1 to 9 short (max 55 characters each). The 10th item can be up to 75 characters.
      Title for daily phrases has to be in english.
      In case of quiz, the right answer has to be always the first option.
      Output ONLY valid, raw JSON with no extra words or markdown blocks:
{
  "slides": [
    {
      "id": "slide-1",
      "type": "phrases",
      "title": "🇫🇷 Daily Phrases",
      "items": ["Bonjour (Hello)", "Merci (Thank you)"],
      "backgroundColor": "linear-gradient(135deg,  #e4e7eb, #eaedf1)",
      "textColor": "#ffffff",
      "fontFamily": "system-ui, -apple-system, sans-serif",
      "fontWeight": "bold",
      "fontSize": 45,
      "watermarkText": "Lérins AI"
    },
    {
      "id": "slide-2",
      "type": "quiz",
      "question": "What is 'Hello' in French?",
      "options": ["Bonjour", "Hola", "Ciao"],
      "backgroundColor": "linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045)",
      "textColor": "#ffffff",
      "fontFamily": "system-ui, -apple-system, sans-serif",
      "fontWeight": "bold",
      "fontSize": 45,
      "watermarkText": "Lérins AI"
    }
  ]
}`;

    try {
      let rawText = "";
      const selectedEngine = engineSelect.value;

      if (selectedEngine === "nano") {
        const engine = (window as any).ai?.languageModel || (window as any).LanguageModel;
        if (!engine) throw new Error("Local Gemini Nano API not enabled.");

        if (!nanoSession) {
          nanoSession = await engine.create();
        }

        const fullPrompt = `${systemPrompt}\n\nCurrent JSON Context:\n${JSON.stringify(config)}\n\nUser instructions: ${query}`;
        const stream = nanoSession.promptStreaming(fullPrompt, { signal: abortController.signal });

        for await (const chunk of stream) {
          rawText += chunk;
        }
      } else {
        const apiKey = selectedEngine === "custom" ? customApiKeyInput.value.trim() : HARDCODED_DEMO_KEY + "zA";
        if (selectedEngine === "custom" && !apiKey) {
          throw new Error("Please supply a valid Gemini API key.");
        }

        // 1. Fetch available models for the API key
        const modelsListResponse = await fetch(
          `https://generativelanguage.googleapis.com/v1beta/models?key=${apiKey}`,
          { signal: abortController.signal }
        );

        if (!modelsListResponse.ok) {
          throw new Error(`Failed to list models: ${modelsListResponse.statusText}`);
        }

        const modelsData = await modelsListResponse.json();

        // 2. Filter models that support generateContent
        const validModels = (modelsData.models || []).filter((m) =>
          m.supportedGenerationMethods?.includes("generateContent")
        );

        if (validModels.length === 0) {
          throw new Error("No available models support generateContent for this API key.");
        }

        // 3. Define priority order for preferred lightweight/flash models
        const preferredFlashModels = [
          "gemini-3.6-flash",
          "gemini-2.0-flash",
          "gemini-1.5-flash"
        ];

        // Locate the best matching model from available models list
        let selectedModelObj = validModels.find((m) =>
          preferredFlashModels.some((pref) => m.name.includes(pref))
        );

        // Fallback: If no priority match, pick any model containing 'flash' or 'lite', or the first available
        if (!selectedModelObj) {
          selectedModelObj =
            validModels.find((m) => m.name.includes("flash") || m.name.includes("lite")) ||
            validModels[0];
        }

        // Strip 'models/' prefix if present in m.name
        const modelName = selectedModelObj.name.replace(/^models\//, "");

        // 4. Construct endpoint and send request
        const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`;

        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          signal: abortController.signal,
          body: JSON.stringify({
            contents: [
              {
                role: "user",
                parts: [{ text: `${systemPrompt}\n\nCurrent JSON:\n${JSON.stringify(config)}\n\nRequest: ${query}` }]
              }
            ]
          })
        });

        const data = await response.json();
        if (data.error) throw new Error(data.error.message || "Cloud Request Failed.");
        rawText = data.candidates?.[0]?.content?.parts?.[0]?.text || "";
      }

      const cleaned = rawText.replace(/```json/g, "").replace(/```/g, "").trim();
      const parsed = JSON.parse(cleaned);

      if (parsed.slides && Array.isArray(parsed.slides)) {
        config = parsed;
        jsonConfigInput.value = JSON.stringify(config, null, 2);
        currentSlideIndex = 0;
        syncUIWithState();

        // Clear streaming text clean and build structured content
        aiBubble.textContent = "";

        const msgText = document.createElement("span");
        msgText.textContent = `✨ Generated ${config.slides.length} slide(s) successfully!`;

        const canvasBtn = document.createElement("button");
        canvasBtn.type = "button";
        canvasBtn.className = "md:hidden mt-2 self-start bg-[#539bf5] hover:bg-[#4182d6] text-white font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 shadow-sm";
        canvasBtn.innerHTML = `<span>👁️</span><span>View Slides</span>`;

        canvasBtn?.addEventListener("click", () => {
          // Mobile only: swap view visibilities
          if (window.innerWidth < 768) {
            dataInputView.classList.add("hidden");
            dataInputView.classList.remove("flex");

            storyEditorView.classList.remove("hidden");
            storyEditorView.classList.add("flex");
          }
          
          // Render canvas state
          renderCanvas();
        });

        aiBubble.appendChild(msgText);
        aiBubble.appendChild(canvasBtn);

      } else {
        throw new Error("Received invalid JSON schema.");
      }

    } catch (err: any) {
      if (err.name === 'AbortError') {
        aiBubble.textContent = ' [Generation Stopped]';
      } else {
        aiBubble.textContent = "Error: " + err.message;
      }
    } finally {
      aiBubble.classList.remove("streaming");
      setStreamingUI(false);
      abortController = null;
    }
  }

  sendBtn.onclick = handleChatSend;
  promptInput.onkeydown = (e) => { if (e.key === 'Enter') handleChatSend(); };

  // Canvas Engine
  function drawWrappedText(context: CanvasRenderingContext2D, text: string, x: number, y: number, maxWidth: number, lineHeight: number, align = "center") {
    const words = text.split(" ");
    let line = "";
    let currentY = y;
    context.textAlign = align as CanvasTextAlign;

    for (let n = 0; n < words.length; n++) {
      const testLine = line + words[n] + " ";
      const metrics = context.measureText(testLine);
      if (metrics.width > maxWidth && n > 0) {
        context.fillText(line.trim(), x, currentY);
        line = words[n] + " ";
        currentY += lineHeight;
      } else {
        line = testLine;
      }
    }
    context.fillText(line.trim(), x, currentY);
  }

  function drawBackground(bgValue: string) {
    if (bgValue.startsWith("linear-gradient")) {
      const colors = bgValue.match(/#(?:[0-9a-fA-F]{3}){1,2}\b/g) || [" #e4e7eb, #eaedf1"];
      const gradient = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
      const step = 1 / (colors.length - 1);
      
      colors.forEach((col, idx) => {
        gradient.addColorStop(idx * step, col);
      });
      ctx.fillStyle = gradient;
    } else {
      ctx.fillStyle = bgValue || "#1e293b";
    }
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }

  function renderCanvas(isExporting = false) {
    const slide = config.slides[currentSlideIndex];
    if (!slide) return;

    const textColor = slide.textColor || "#ffffff";
    const fontWeight = slide.fontWeight || "bold"; 
    const fontFamily = slide.fontFamily || "system-ui, sans-serif";

    // Always reset root canvas composite states before drawing frame
    ctx.save();
    ctx.globalAlpha = 1.0;

    // 1. Draw Background
    drawBackground(slide.backgroundColor || "#1e293b");

    const baseFontSize = slide.fontSize || 45;
    const fontStyle = slide.textStyle?.includes("italic") ? "italic" : "";
    const titleYStart = 500;
    const paddingLeft = 140;
    
    // --- A. Phrases Slide Type ---
    if (slide.type === "phrases") {
      // Header Title
      ctx.save();

      drawText(ctx, slide.title || "🇫🇷 Daily Phrases", {
        x: paddingLeft,
        y: titleYStart,
        width: 880,
        height: 120,
        align: "left",
        vAlign: "top",
        font: fontFamily,
        fontSize: baseFontSize + 20,
        fontWeight: fontWeight,
        fontStyle: fontStyle,
        style: { fill: textColor }
      });
      ctx.restore();

      // Phrases List
      const items = (slide.items || []).slice(0, 10);
      const contentYStart = titleYStart + 130;
      const contentHeight = 1350;
      const formattedPhrases = items.map((phrase) => `•  ${phrase}`).join("\n");

      ctx.save();

      drawText(ctx, formattedPhrases, {
        x: paddingLeft,
        y: contentYStart,
        width: 880,
        height: contentHeight,
        align: "left",
        vAlign: "top",
        font: fontFamily,
        fontSize: baseFontSize,
        fontWeight: fontWeight,
        fontStyle: fontStyle,
        lineHeight: Math.round(baseFontSize * 1.4),
        style: { fill: textColor }
      });
      ctx.restore();
    } 

    // --- B. Quiz Slide Type ---
    else if (slide.type === "quiz") {
      const questionText = slide.question || "Which feature should we build next?";
      const rawOptions = slide.options && slide.options.length > 0 
        ? slide.options 
        : ["AI Generator", "Custom Fonts", "More Layouts"];

      const optionsList = [...rawOptions].sort(() => Math.random() - 0.5);

      ctx.save();

      drawText(ctx, questionText, {
        x: paddingLeft,
        y: titleYStart,
        width: 880,
        height: 300,
        align: "left",
        vAlign: "middle",
        font: fontFamily,
        fontSize: baseFontSize + 10,
        fontWeight: fontWeight,
        style: { fill: textColor }
      });
      ctx.restore();

      // Quiz Options List
      const optionsText = optionsList.map((opt, i) => `${String.fromCharCode(65 + i)}. ${opt}`).join("\n");

      ctx.save();
      drawText(ctx, optionsText, {
        x: 150,
        y: 750,
        width: 780,
        height: 700,
        align: "left",
        vAlign: "top",
        font: fontFamily,
        fontSize: baseFontSize,
        fontWeight: fontWeight,
        lineHeight: Math.round(baseFontSize * 1.4),
        style: { fill: textColor }
      });
      ctx.restore();
    }

    // --- C. Draw Watermark ---
    if (slide.watermarkText) {
      ctx.save();
      ctx.globalAlpha = 0.6;
      drawText(ctx, slide.watermarkText, {
        x: 0,
        y: 1400,
        width: canvas.width,
        height: 80,
        align: "center",
        vAlign: "bottom",
        font: fontFamily,
        fontSize: 24,
        style: { fill: textColor }
      });
      ctx.restore();
    }

    // --- D. Dotted sticker overlay for interactive quiz elements ---
    if (!isExporting && slide.type === "quiz") {
      const boxWidth = 880;
      const boxHeight = 180 + (slide.options ? slide.options.length * 90 : 200);
      const boxX = (canvas.width - boxWidth) / 2;
      const boxY = 1050;

      ctx.save();
      ctx.strokeStyle = textColor;
      ctx.globalAlpha = 0.8;
      ctx.lineWidth = 6;
      ctx.setLineDash([16, 12]);
      ctx.beginPath();
      ctx.roundRect(boxX, boxY, boxWidth, boxHeight, 32);
      ctx.stroke();

      ctx.fillStyle = textColor;
      ctx.globalAlpha = 0.5;
      ctx.font = `28px ${fontFamily}`;
      ctx.textAlign = "center";
      ctx.fillText("Place IG Poll Action item here", canvas.width / 2, boxY + 70);
      ctx.restore();
    }

    // --- E. IG Top profile image circle (Editor mode only) ---
    if (!isExporting) {
      const avatarRadius = 50;
      const avatarCenterX = 100;
      const avatarCenterY = 160;

      ctx.save();
      ctx.strokeStyle = textColor;
      ctx.globalAlpha = 0.6;
      ctx.lineWidth = 4;
      ctx.setLineDash([12, 10]);

      ctx.beginPath();
      ctx.arc(avatarCenterX, avatarCenterY, avatarRadius, 0, Math.PI * 2);
      ctx.stroke();

      ctx.fillStyle = textColor;
      ctx.globalAlpha = 0.5;
      ctx.font = `28px ${fontFamily}`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText("", avatarCenterX, avatarCenterY);
      ctx.restore();

      ctx.save();
      ctx.fillStyle = textColor;
      ctx.globalAlpha = 0.5;
      ctx.font = `bold 30px ${fontFamily}`;
      ctx.textAlign = "left";
      ctx.textBaseline = "middle";

      const textX = avatarCenterX + avatarRadius + 20;
      ctx.fillText("Profile Placeholder now", textX, avatarCenterY);
      ctx.restore();
    }

    // --- F. IG Bottom Message Input Placeholder Box (Editor mode only) ---
    if (!isExporting) {
      const msgBoxWidth = 980;
      const msgBoxHeight = 110;
      const msgBoxX = (canvas.width - msgBoxWidth) / 2;
      const msgBoxY = 1730;
      const cornerRadius = 55;

      ctx.save();
      ctx.strokeStyle = textColor;
      ctx.fillStyle = "rgba(0, 0, 0, 0.2)";
      ctx.globalAlpha = 0.6;
      ctx.lineWidth = 4;
      ctx.setLineDash([12, 10]);

      ctx.beginPath();
      ctx.roundRect(msgBoxX, msgBoxY, msgBoxWidth, msgBoxHeight, cornerRadius);
      ctx.fill();
      ctx.stroke();

      drawText(ctx, "Send message...", {
        x: msgBoxX + 40,
        y: msgBoxY,
        width: msgBoxWidth - 80,
        height: msgBoxHeight,
        align: "left",
        vAlign: "middle",
        font: fontFamily,
        fontSize: 32,
        style: { fill: textColor }
      });

      ctx.restore();
    }

    // --- G. IG Progress Bar Indicators (Editor mode only) ---
    if (!isExporting && config.slides.length > 0) {
      const msgBoxWidth = 980;
      const msgBoxHeight = 110;
      const msgBoxX = (canvas.width - msgBoxWidth) / 2;
      const msgBoxY = 1730;

      ctx.save();
      ctx.strokeStyle = textColor;
      ctx.globalAlpha = 0.6;
      ctx.lineWidth = 4;
      ctx.setLineDash([12, 10]);
      ctx.beginPath();
      ctx.roundRect(msgBoxX, msgBoxY, msgBoxWidth, msgBoxHeight, 55);
      ctx.stroke();

      ctx.fillStyle = textColor;
      ctx.globalAlpha = 0.5;
      ctx.font = `26px ${fontFamily}`;
      ctx.textAlign = "center";
      ctx.restore();
    }

    // Restore root state stack
    ctx.restore();
  }

  // Compile complete canvas font string including style, size, and family
  function getCanvasFont(baseSize: number, slide: SlideData): string {
    const style = slide.textStyle || "bold";
    const size = slide.fontSize;
    const family = slide.fontFamily || "system-ui, sans-serif";
    return `${style} ${size}px ${family}`;
  }

  function syncUIWithState() {
    const slide = config.slides[currentSlideIndex];
    if (!slide) return;

    textStyleSelect.value = slide.textStyle || "bold";

    const currentBg = slide.backgroundColor || "#1e293b";
    
    let matchedOption = Array.from(bgTypeSelect.options).find(opt => opt.value === currentBg);
    if (matchedOption) {
      bgTypeSelect.value = currentBg;
      bgColorPicker.classList.add("hidden");
    } else {
      bgTypeSelect.value = "custom";
      bgColorPicker.value = currentBg.startsWith("#") ? currentBg : "#1e293b";
      bgColorPicker.classList.remove("hidden");
    }

    textColorPicker.value = slide.textColor || "#1b1818";
    fontSelect.value = slide.fontFamily || "system-ui, -apple-system, sans-serif";
    
    slideIndicator.textContent = `${currentSlideIndex + 1}/${config.slides.length}`;
    renderCanvas();
  }

  const decreaseFontSizeBtn = document.getElementById('decreaseFontSizeBtn');
  const increaseFontSizeBtn = document.getElementById('increaseFontSizeBtn');

  function updateFontSize(newSize) {
    const MIN_SIZE = 20;
    const MAX_SIZE = 120; 
    // Clamp value between limits
    const clampedSize = Math.min(Math.max(newSize, MIN_SIZE), MAX_SIZE);
    
    
    config.slides[currentSlideIndex].fontSize = clampedSize;
    renderCanvas();

    //const val = (e.target as HTMLSelectElement).value as any;
    //config.slides[currentSlideIndex].fontSize = val;
    //jsonConfigInput.value = JSON.stringify(config, null, 2);
    //renderCanvas();
  }

  // Decrease button click
  decreaseFontSizeBtn.addEventListener('click', () => {
    const current = parseInt(config.slides[currentSlideIndex].fontSize, 10) || 45;
    updateFontSize(current - 2);
  });

  // Increase button click
  increaseFontSizeBtn.addEventListener('click', () => {
    const current = parseInt(config.slides[currentSlideIndex].fontSize, 10) || 45;
    updateFontSize(current + 2);
  });

  jsonConfigInput.addEventListener("input", () => {
    try {
      const parsed = JSON.parse(jsonConfigInput.value);
      if (parsed.slides && Array.isArray(parsed.slides) && parsed.slides.length > 0) {
        config = parsed;
        syncUIWithState();
      }
    } catch (e) {}
  });

  closeJsonBtn?.addEventListener("click", () => {
    dataInputView.classList.add("hidden");
    dataInputView.classList.remove("flex");

    storyEditorView.classList.remove("hidden");
    storyEditorView.classList.add("flex");
  });

  // Switch from Story View -> AI View on Mobile
  openJsonBtn?.addEventListener("click", () => {
    storyEditorView.classList.add("hidden");
    storyEditorView.classList.remove("flex");

    dataInputView.classList.remove("hidden");
    dataInputView.classList.add("flex");
  });

  textStyleSelect.addEventListener("change", (e) => {
    const val = (e.target as HTMLSelectElement).value as any;
    config.slides[currentSlideIndex].textStyle = val;
    jsonConfigInput.value = JSON.stringify(config, null, 2);
    renderCanvas();
  });


  generateBtn.addEventListener("click", () => {
    try {
      config = JSON.parse(jsonConfigInput.value);
      currentSlideIndex = 0;
      syncUIWithState();
      
      // Auto-focus and reveal canvas viewport view on mobile/tablet
      if (window.innerWidth < 768) {
        dataInputView.classList.add("hidden");
        dataInputView.classList.remove("flex", "fixed", "inset-2", "z-50");
      }
    } catch (e) { alert("Invalid JSON format in code editor."); }
  });

  loadSampleBtn.addEventListener("click", () => {
    jsonConfigInput.value = JSON.stringify(defaultSample, null, 2);
    config = defaultSample;
    syncUIWithState();
  });

  bgTypeSelect.addEventListener("change", (e) => {
    const val = (e.target as HTMLSelectElement).value;
    if (val === "custom") {
      bgColorPicker.classList.remove("hidden");
      config.slides[currentSlideIndex].backgroundColor = bgColorPicker.value;
    } else {
      bgColorPicker.classList.add("hidden");
      config.slides[currentSlideIndex].backgroundColor = val;
    }
    jsonConfigInput.value = JSON.stringify(config, null, 2);
    renderCanvas();
  });

  bgColorPicker.addEventListener("input", (e) => {
    const val = (e.target as HTMLInputElement).value;
    config.slides[currentSlideIndex].backgroundColor = val;
    jsonConfigInput.value = JSON.stringify(config, null, 2);
    renderCanvas();
  });

  textColorPicker.addEventListener("input", (e) => {
    const val = (e.target as HTMLInputElement).value;
    config.slides[currentSlideIndex].textColor = val;
    jsonConfigInput.value = JSON.stringify(config, null, 2);
    renderCanvas();
  });

  fontSelect.addEventListener("change", (e) => {
    const val = (e.target as HTMLSelectElement).value;
    config.slides[currentSlideIndex].fontFamily = val;
    jsonConfigInput.value = JSON.stringify(config, null, 2);
    renderCanvas();
  });

  prevBtn.addEventListener("click", () => {
    if (currentSlideIndex > 0) {
      currentSlideIndex--;
      syncUIWithState();
    }
  });

  nextBtn.addEventListener("click", () => {
    if (currentSlideIndex < config.slides.length - 1) {
      currentSlideIndex++;
      syncUIWithState();
    }
  });

  downloadBtn.addEventListener("click", () => {
    // Render standard canvas without editor overlays for clean exports
    
    renderCanvas(true);
    
    requestAnimationFrame(() => {
      const link = document.createElement("a");
      link.download = `slide-${currentSlideIndex + 1}.png`;
      link.href = canvas.toDataURL("image/png", 1.0);
      link.click();

      // 3. Restore standard editor view guides
      renderCanvas(false);
    });
  });

  checkNanoAvailability();
  syncUIWithState();
</script>