---
import Layout from "../layouts/Layout.astro";

const feedbacks = [
  { title: "E-Bike Rental Availability Inquiry", message: "User asked if E-Bikes are available for a family of 4 tomorrow morning in Antibes. AI provided pricing (€35/day) and direct booking link.", type: "High Intent", sentiment: "Positive", tags: ["E-Bike", "Family Rental", "High-Intent"], date: "2026-09-13" },
  { title: "Unmet Demand: Child Seat Request", message: "Visitor asked if child trailers or rear seats can be attached to E-Bikes. AI noted that child seats are currently out of stock for online booking.", type: "Unmet Demand", sentiment: "Neutral", tags: ["Child Seat", "Inventory Gap", "Feature Request"], date: "2026-09-12" },
  { title: "Coastal Route & Map Recommendations", message: "User asked for safe cycling paths to Cap d'Antibes avoiding heavy car traffic. AI suggested the coastal bike route.", type: "Feedback", sentiment: "Positive", tags: ["Cap d'Antibes", "Route Advice", "AI Guidance"], date: "2026-09-11" },
  { title: "Widget Mobile Overlay Issue", message: "The chat widget bubble covers the Checkout button on iOS Safari screens under 390px width.", type: "Bug", sentiment: "Frustrated", tags: ["Mobile", "UI Bug", "Safari"], date: "2026-09-10" },
  { title: "Dark Mode Request for Plugin Widget", message: "User requested an automatic dark mode trigger based on system preference for nighttime browsing.", type: "Feature Request", sentiment: "Neutral", tags: ["Dark Theme", "Customization"], date: "2026-09-08" },
];
---

<Layout title="Dashboard | Lérins AI">
  <main class="bg-slate-50 px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-col justify-between gap-4 border-b border-slate-200 pb-6 md:flex-row md:items-center"><div><h1 class="text-3xl font-extrabold text-slate-950">AI Analytics & Conversational Insights</h1><p class="mt-1 text-sm text-slate-500">Real-time intent tracking, user feedback, and lead conversion logs.</p></div><span class="inline-flex w-fit rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">● AI Engine Live</span></div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs uppercase tracking-wider text-slate-500">Total Conversations</p><p class="mt-2 text-2xl font-extrabold text-slate-950">5 <span class="text-xs text-emerald-600">+12% this week</span></p></div><div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs uppercase tracking-wider text-slate-500">AI Resolution Rate</p><p class="mt-2 text-2xl font-extrabold text-blue-600">84.2%</p></div><div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs uppercase tracking-wider text-slate-500">High-Intent Leads</p><p class="mt-2 text-2xl font-extrabold text-emerald-600">1</p></div><div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-xs uppercase tracking-wider text-slate-500">Customer Sentiment</p><p class="mt-2 text-2xl font-extrabold text-slate-800">78% Positive</p></div></div>
      <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,448px)_1fr]"><ul class="space-y-3">{feedbacks.map((feedback) => <li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><div class="flex items-start justify-between gap-3"><h2 class="font-bold text-slate-950">{feedback.title}</h2><time class="whitespace-nowrap text-xs text-slate-400">{feedback.date}</time></div><p class="mt-2 text-xs leading-relaxed text-slate-600">{feedback.message}</p><div class="mt-3 flex flex-wrap gap-2 text-[10px] font-semibold"><span class="rounded-md bg-blue-50 px-2 py-0.5 text-blue-700">{feedback.sentiment}</span><span class="rounded-md bg-slate-100 px-2 py-0.5 text-slate-700">{feedback.type}</span>{feedback.tags.map((tag) => <span class="rounded bg-slate-100 px-2 py-0.5 text-slate-600">#{tag}</span>)}</div></li>)}</ul><section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-xs font-semibold uppercase tracking-wider text-blue-600">Selected conversation</p><h2 class="mt-2 text-2xl font-bold text-slate-950">{feedbacks[0].title}</h2><p class="mt-4 border-l-4 border-blue-100 pl-4 italic leading-relaxed text-slate-700">{feedbacks[0].message}</p><h3 class="mt-8 font-semibold text-slate-800">Tags</h3><div class="mt-2 flex flex-wrap gap-2">{feedbacks[0].tags.map((tag) => <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-700">#{tag}</span>)}</div><h3 class="mt-8 font-semibold text-slate-800">Comments</h3><p class="mt-2 rounded-lg bg-slate-100 px-4 py-3 text-sm text-slate-700">AI successfully converted user to booking flow.</p></section></div>
    </div>
  </main>
</Layout>